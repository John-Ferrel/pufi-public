# image-openai config — copy to <workspace>/.bot/image.env, then chmod 600.
# Size / quality are per-call CLI params, not stored here.

IMAGE_API_URL=https://api.example.com
IMAGE_API_KEY=sk-REPLACE_ME
IMAGE_MODEL=gpt-image-2

# Optional
# IMAGE_OUTPUT_DIR=/absolute/path/to/outputs

# Legacy names still honoured (IMAGE_* wins):
# PUFI_IMAGE_API_URL / PUFI_IMAGE_API_KEY / PUFI_IMAGE_MODEL / PUFI_IMAGE_OUTPUT_DIR
