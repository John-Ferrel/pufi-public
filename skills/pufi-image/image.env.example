# Pufi Image API — local config example
# Copy this file to ~/.config/pufi/image.env and fill in your real values.
# This file itself is safe to commit (no secrets here).
#
# NOTE: size / quality are NOT configured here — they are per-call CLI params
# chosen by the agent for each image (see SKILL.md).

PUFI_IMAGE_API_URL=https://api.example.com
PUFI_IMAGE_API_KEY=sk-your-key-here
PUFI_IMAGE_MODEL=gpt-image-2

# Optional: override where generated images are saved
# PUFI_IMAGE_OUTPUT_DIR=/path/to/outputs