# Pufi Anime Image API — Latent config example
# Copy this file to ~/.config/pufi/anime.env and fill in your real values.
# This file itself is safe to commit (no secrets here).

LATENT_API_KEY=
LATENT_BASE_URL=https://latent.moe

# Optional: override where generated images are saved
# PUFI_ANIME_OUTPUT_DIR=/path/to/outputs